    {
      "action": "tap",
      "x": 220,
      "y": 220
    },
    {
      "action": "wait",
      "duration_ms": 400
    },
    {
      "action": "screenshot",
      "name": "02-channels"
    },
    {
      "action": "tap",
      "x": 28,
      "y": 99
    },
    {
      "action": "wait",
      "duration_ms": 500
    },
    {
      "action": "tap",
      "x": 220,
      "y": 200
    },
    {
      "action": "wait",
      "duration_ms": 800
